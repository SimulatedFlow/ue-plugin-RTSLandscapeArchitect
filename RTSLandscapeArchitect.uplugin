	"EngineVersion": "5.8.0",
	"FriendlyName": "RTS & Topdown Landscape Architect",
	"Description": "Automatic multi-level plateau landscape generation with clean ramps, cliffs and bounded map borders (mountains or water) for RTS, topdown and turn-based tactics games. Generates editable geometry in the editor or fully procedural ProceduralMesh terrain at runtime, then triggers PCG decoration and rebuilds the NavMesh. Engine-only, full C++ source.",
	"Category": "Code Plugins",
	"CreatedBy": "Silvan Teufel",
	"CreatedByURL": "https://silvan.teufel-engineering.com",
	"DocsURL": "https://github.com/SimulatedFlow/ue-plugin-RTSLandscapeArchitect",
	"SupportURL": "mailto:teufelsilvan@gmail.com",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "RTSLandscapeArchitect",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "RTSLandscapeArchitectEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64"
			]
		}
	],
	"Plugins": [
